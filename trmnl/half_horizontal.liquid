{%- assign leader = standings[0] -%}
<div class="layout layout--row">
  {%- if standings.size > 0 %}
  <div class="grid w--full">
    <div class="col--span-4 flex flex--col flex--center gap--small text--center">
      {%- if leader.logo %}<img class="image image-dither w--14 h--14" src="{{ leader.logo }}" alt="">{% endif %}
      <span class="title title--small" data-clamp="1">{{ leader.name }}</span>
      <span class="label label--small label--inverted">Leader · {{ leader.points }} pts</span>
    </div>
    <div class="col--span-8">{% render "standings_table", standings: standings, count: window_rows, start: win_start, wdl: true, gd: true, size: "table--xsmall lg:table--small", crest: "w--4 h--4", fav_pos: fav_pos, zone_direct: zone_direct, zone_playoff: zone_playoff %}</div>
  </div>
  {%- else %}
  {% render "empty_state" %}
  {%- endif %}
</div>

{% render "league_title_bar", logo_class: logo_class, league_logo: league_logo, league_name: league_name, subtitle: subtitle %}
